NEXT_PUBLIC_SUPABASE_URL=https://pswzsdjxvrwkorcgujwv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: a Google OAuth "Web application" client id for this site, with
# https://russvitale.com as an authorized JavaScript origin. With it, Google's
# screen names russvitale.com instead of the Supabase address. Also add it to
# Supabase > Authentication > Providers > Google > Client IDs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Newsletter (Resend). FROM must use a domain verified in Resend, e.g.
# "Russ Fan Archive <news@russvitale.com>". ADDRESS is the postal address
# US law wants in every email. SECRET matches russ_settings.newsletter_secret.
RESEND_API_KEY=
RUSS_NEWSLETTER_FROM=
RUSS_NEWSLETTER_ADDRESS=
RUSS_NEWSLETTER_SECRET=

# Shared with the WordPress subsite so a published post refreshes /blog (see /api/blog-published).
RUSS_BLOG_WEBHOOK_SECRET=
